rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // =========================================================================
    // OGLESBY HEALTHCARE CLOUD STORAGE ISOLATION GUARDRAIL
    // All uploads MUST go to /oglesby_healthcare/{env}/{category}/{id}/{filename}
    // =========================================================================
    match /oglesby_healthcare/{env}/{category}/{id}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && request.resource.size < 20 * 1024 * 1024 // 20MB Max
        && (category in ['users', 'consultations', 'intake_forms', 'avatars', 'documents']);
    }
  }
}
