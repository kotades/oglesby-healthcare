rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // OGLESBY HEALTHCARE STRICT DATA ISOLATION GUARDRAILS
    // All Oglesby Healthcare data resides under /oglesby_healthcare/{version}/
    // Completely isolated from any other apps sharing 'kota-reuse'
    // =========================================================================
    match /oglesby_healthcare/{version} {
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Explicitly deny root access outside of oglesby_healthcare namespace
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
