rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only allow operations in the Oglesby Healthcare namespace
    match /oglesby_healthcare/{version} {
      
      // Users can only read and write their own data
      match /users/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Admin/System collections or specific subcollections
      match /{document=**} {
        // Broad default to deny anything outside explicit rules above
        allow read, write: if false;
      }
    }
    
    // Explicitly deny root access outside of namespace
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
